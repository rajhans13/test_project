variable "region" {
  description = "AWS region used for all resources"
  type        = string
  default     = "us-west-2"
}

variable "profile_name" {
  description = "Shared credentials profile for authentication"
  type        = string
  default     = "default"
}

variable "instance_type" {
  description = "EC2 instance type for the web tier"
  type        = string
  default     = "t3.small"
}

variable "instance_key" {
  description = "Name of the existing SSH key pair"
  type        = string
  default     = "saravanan-ec2-key"
}

variable "vpc_cidr" {
  description = "CIDR block allocated to the VPC"
  type        = string
  default     = "178.0.0.0/16"
}

variable "public_subnet_cidr" {
  description = "CIDR block allocated to the public subnet"
  type        = string
  default     = "178.0.10.0/24"
}

variable "availability_zone" {
  description = "Availability zone for the public subnet"
  type        = string
  default     = "us-west-2a"
}

variable "web_ami" {
  description = "AMI identifier for the web instance"
  type        = string
  default     = "ami-0d70546e43a941d70"
}

variable "deployment_version" {
  description = "Release identifier applied across Terraform, runbooks, and DSC artifacts"
  type        = string
  default     = "v2025.0.1"
}
