#!/usr/bin/env bash
set -euo pipefail

APPNAME="demo_app"
DCONFIG="CodeDeployDefault.AllAtOnce"
DGNAME="cd_dg1"
DESCRIPTION="Demo Deployment"
BUCKET="S3Bucket Name"
ETAG="ETAG's NAME"
BUNDLETYPE="zip"
KEY="demo_app.zip"
REGION="us-east-1"
VERSION_TAG="v2025.0.1"
CHANGE_LOG_PATH="$(pwd)/deployment-change-log.md"

cat <<CHANGELOG > "${CHANGE_LOG_PATH}"
# Deployment ${VERSION_TAG}
- Source: Terraform module release ${VERSION_TAG}
- Runbook update: create-deployment.rtf aligned to retrospective actions
- DSC baseline: scripts/dsc/ApplyWebConfig.ps1
- CAB Reference: docs/cab-minutes-2025-02-20.md
CHANGELOG

echo "Writing deployment metadata to ${CHANGE_LOG_PATH}"

aws deploy create-deployment \
    --application-name "${APPNAME}" \
    --deployment-config-name "${DCONFIG}" \
    --deployment-group-name "${DGNAME}" \
    --description "${DESCRIPTION} (${VERSION_TAG})" \
    --s3-location bucket="${BUCKET}",bundleType="${BUNDLETYPE}",eTag="${ETAG}",key="${KEY}" \
    --region "${REGION}"

printf '\nAction items recorded in Azure DevOps Wiki under Platform Operations > Continuous Improvement > 2025-Q1 Retrospective.\n'
